+package org.glukopapa.v3.m00
+
+import android.content.Intent
+import android.view.ViewGroup
+import android.view.accessibility.AccessibilityNodeInfo
+import android.webkit.WebView
+import androidx.test.ext.junit.runners.AndroidJUnit4
+import androidx.test.platform.app.InstrumentationRegistry
+import org.junit.Assert.*
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.json.JSONArray
+import org.json.JSONObject
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.TimeUnit
+import java.util.concurrent.atomic.AtomicReference
+
+/** Actual bundled WebView + Android dialog + GFStorage. Synthetic instrumentation database only. */
+@RunWith(AndroidJUnit4::class)
+class Q08LevemirWebViewInstrumentedTest {
+    private val instr get()=InstrumentationRegistry.getInstrumentation()
+    private val ctx get()=instr.targetContext
+    private fun js(web:WebView,code:String):String{
+        val done=CountDownLatch(1);val result=AtomicReference("null")
+        instr.runOnMainSync{web.evaluateJavascript(code){v->result.set(v);done.countDown()}}
+        assertTrue("Q08 JS timeout",done.await(25,TimeUnit.SECONDS));return result.get()
+    }
+    private fun until(web:WebView,code:String,expected:String){repeat(70){if(js(web,code)==expected)return;Thread.sleep(250)};fail("Q08 WebView expected $expected for $code; got ${js(web,code)}")}
+    private fun decoded(raw:String)=JSONObject(JSONArray("[$raw]").getString(0))
+    private fun eventCount():Int=GfDbHelper(ctx).use{h->h.readableDatabase.rawQuery("SELECT COUNT(*) FROM v3_events",null).use{c->c.moveToFirst();c.getInt(0)}}
+    private fun dialogButton(label:String){
+        repeat(80){
+            val root=instr.uiAutomation.rootInActiveWindow
+            val nodes=root?.findAccessibilityNodeInfosByText(label)?:emptyList()
+            for(n in nodes){if(n.text?.toString()==label&&n.isClickable&&n.performAction(AccessibilityNodeInfo.ACTION_CLICK))return}
+            Thread.sleep(250)
+        }
+        fail("Q08 native dialog button missing: $label")
+    }
+    @Test fun approvedScreenNativeActivationAndActualConfirmationAreSeparate(){
+        instr.waitForIdleSync();ctx.deleteDatabase("glukopapa_v3.db")
+        GfDbHelper(ctx).use{h->h.writableDatabase.execSQL("UPDATE v3_meta SET profile_id='q08-web-qa',timezone='Europe/Minsk' WHERE id=1")}
+        val activity=instr.startActivitySync(Intent(ctx,MainActivity::class.java).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)) as MainActivity
+        try{
+            val web=activity.findViewById<ViewGroup>(android.R.id.content).getChildAt(0) as WebView
+            until(web,"document.readyState","\"complete\"")
+            js(web,"document.querySelector('[data-module=GFInjectionEntry]').click();true")
+            until(web,"location.pathname","\"/q08/levemir.html\"");until(web,"document.readyState","\"complete\"")
+            assertEquals("\"undefined\"",js(web,"typeof GPV3Q08Native.append"));assertEquals("\"undefined\"",js(web,"typeof GPV3Q08Native.setCoverageComplete"))
+            until(web,"document.getElementById('q08-activation').hidden","false");assertEquals(0,eventCount());assertFalse(decoded(js(web,"GPV3Q08Native.readStatus()")).getBoolean("active"))
+            assertEquals( "true",js(web,"document.querySelectorAll('details[open]').length===0"))
+            js(web,"document.getElementById('q08-activate').click();true");dialogButton("Отмена");until(web,"document.getElementById('q08-activation-status').textContent.includes('OWNER_CANCELLED')","true");assertEquals(0,eventCount())
+            js(web,"document.getElementById('q08-activate').click();true");dialogButton("Подтвердить");until(web,"document.getElementById('q08-activation')?.hidden===true","true");until(web,"JSON.parse(GPV3Q08Native.readStatus()).active===true","true");assertEquals(0,eventCount())
+            until(web,"document.getElementById('zone-morning')?.textContent==='Europe/Minsk'","true")
+            js(web,"document.getElementById('dose-morning').value='1.5';document.getElementById('date-morning').value='2025-01-30';document.getElementById('time-morning').value='08:00';document.getElementById('site-morning').value='Ягодица';document.querySelector('#form-morning button[type=submit]').click();true")
+            // Pending owner confirmation must not create a fact.
+            assertEquals(0,eventCount());dialogButton("Подтвердить")
+            until(web,"document.getElementById('message-morning').textContent.includes('Записано в GFStorage')","true");assertEquals(1,eventCount())
+            val snapshot=decoded(js(web,"GPV3Q08Native.readState()"));val e=snapshot.getJSONObject("data").getJSONArray("events").getJSONObject(0)
+            assertEquals("levemir",e.getString("insulinId"));assertEquals("basal",e.getString("insulinClass"));assertEquals("2025-01-30T05:00:00Z",e.getString("occurredAtUtc"));assertEquals("buttock",e.getString("injectionSite"));assertEquals(1.5,e.getDouble("units"),0.000001)
+            assertEquals("\"\"",js(web,"document.getElementById('dose-morning').value"))
+        }finally{GfV3QaActivityLifecycle.finishAndAwait(instr,activity);ctx.deleteDatabase("glukopapa_v3.db")}
+    }
+}
