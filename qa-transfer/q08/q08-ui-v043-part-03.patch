+package org.glukopapa.v3.m00
+
+import android.webkit.JavascriptInterface
+import org.json.JSONObject
+
+/** Only read / request / poll; never exposes native writer or a consent boolean. */
+internal class GfV3Q08Bridge(private val queue:GfV3Q08OwnerQueue){
+    @JavascriptInterface fun readStatus():String=wrap{queue.status()}
+    @JavascriptInterface fun readState():String=wrap{queue.snapshot()}
+    @JavascriptInterface fun resolveLocalTime(raw:String):String=wrap{queue.resolveLocalTime(raw)}
+    @JavascriptInterface fun requestOwnerAction(raw:String):String=wrap{queue.enqueue(raw)}
+    @JavascriptInterface fun pollOwnerAction(ticket:String):String=wrap{queue.poll(ticket)}
+    private fun wrap(block:()->JSONObject):String=try{block().toString()}catch(e:Exception){JSONObject().put("error",JSONObject().put("code",e.message?:"Q08_ERROR")).toString()}
+}
