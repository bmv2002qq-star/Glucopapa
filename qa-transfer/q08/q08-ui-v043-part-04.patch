+package org.glukopapa.v3.m00
+
+import org.json.JSONArray
+import org.json.JSONObject
+import java.time.Instant
+import java.util.UUID
+import java.util.concurrent.Executors
+import java.util.concurrent.TimeUnit
+
+/** Request-only transport for actual historical facts; no medical calculations or browser consent. */
+internal class GfV3Q08OwnerQueue(
+    private val facts:GfV3Q08InjectionFacts,
+    private val history:GfV3Q08History,
+    private val storage:GfV3Storage,
+    private val installer:GfV3Q08ModuleInstaller,
+    private val onConfirm:(String,(Boolean)->Unit)->Unit
+) {
+    private data class Pending(val request:JSONObject,var state:String="PENDING",var result:JSONObject?=null)
+    private val lock=Any()
+    private val worker=Executors.newSingleThreadExecutor { r -> Thread(r,"Q08OwnerWorker").apply{isDaemon=true} }
+    private val pending=linkedMapOf<String,Pending>()
+    private var closed=false
+    private val sites=mapOf("Ягодица" to "buttock","Живот" to "abdomen","Плечо" to "arm","Бедро" to "thigh")
+    private fun strings(a:JSONArray)=(0 until a.length()).map(a::getString).toSet()
+    fun status():JSONObject {
+        val reg=storage.readShellPort("registry")
+        val data=reg.getJSONObject("data")
+        val m=data.getJSONArray("modules")
+        val module=(0 until m.length()).map(m::getJSONObject).single{it.getString("moduleId")==GfV3Q08Rules.OWNER}
+        val g=data.getJSONArray("experimentalWriteGrants")
+        val grant=(0 until g.length()).map(g::getJSONObject).any{it.optString("moduleId")==GfV3Q08Rules.OWNER&&it.optString("role")=="actionWriter"&&it.optString("grantStatus")=="OWNER_GRANTED_EXPERIMENTAL"&&it.optString("implementationStatus")=="PREPARED_NATIVE"}
+        val active=grant&&module.optString("status")=="OWNER_INTEGRATION_ACCEPTED"&&module.optBoolean("featureEnabled")&&strings(module.getJSONArray("readRoles"))==setOf("research")&&strings(module.getJSONArray("writeRoles"))==setOf("actionWriter")
+        val canActivate=grant&&module.optString("status")=="NOT_CONNECTED"&&!module.optBoolean("featureEnabled")&&strings(module.getJSONArray("writeRoles"))==setOf("actionWriter")
+        return JSONObject().put("profileConfigured",reg.getBoolean("profileConfigured")).put("profileId",reg.get("profileId")).put("revision",reg.getLong("revision")).put("active",active).put("canActivate",canActivate)
+    }
+    fun snapshot():JSONObject {
+        require(status().getBoolean("active")){"Q08_PRODUCER_NOT_ACTIVATED"}
+        val h=history.read()
+        val data=h.getJSONObject("data")
+        // Expose only Q08's own input contract, not other research/preferences/coefficients.
+        val safe=JSONObject()
+        val profile=data.getJSONObject("profile")
+        safe.put("profile",JSONObject().put("profileId",profile.getString("profileId")).put("timeZone",profile.getString("timeZone")))
+        for(k in listOf("events","cgm","mealSessions","measurements","q08ReadWindow"))safe.put(k,data.get(k))
+        // Authorization and revision checked again after reading, including a restore or activation race.
+        val s=status()
+        require(s.getBoolean("active")&&s.getLong("revision")==h.getLong("revision")&&s.getString("profileId")==h.getString("profileId")){"Q08_PAGE_CONTEXT_CHANGED"}
+        return JSONObject().put("schemaVersion",3).put("profileConfigured",true).put("profileId",h.getString("profileId")).put("revision",h.getLong("revision")).put("data",safe)
+    }
+    /** Convert a human wall clock using the stored profile zone, not the device zone. */
+    fun resolveLocalTime(raw:String):JSONObject {
+        require(raw.length in 20..500){"Q08_LOCAL_TIME_REQUEST_INVALID"}
+        val req=JSONObject(raw)
+        require(req.keys().asSequence().toSet()==setOf("profileId","expectedRevision","date","time")){"Q08_LOCAL_TIME_FIELDS_INVALID"}
+        val st=status(); require(st.getBoolean("active")){"Q08_PRODUCER_NOT_ACTIVATED"}
+        val settings=storage.readShellPort("settings")
+        require(settings.getBoolean("profileConfigured")&&settings.getString("profileId")==req.getString("profileId")&&settings.getLong("revision")==req.getLong("expectedRevision")&&settings.getLong("revision")==st.getLong("revision")&&settings.getString("profileId")==st.getString("profileId")){"Q08_PAGE_CONTEXT_CHANGED"}
+        val zone=settings.getJSONObject("data").getJSONObject("profile").getString("timeZone")
+        val at=GfV3LocalEditTime.toUtc(req.getString("date"),req.getString("time"),zone)
+        GfV3Q08Rules.parseUtc(at)
+        return JSONObject().put("occurredAtUtc",at).put("timeZone",zone).put("revision",settings.getLong("revision"))
+    }
+    fun enqueue(raw:String):JSONObject {
+        require(raw.length in 20..2500){"Q08_REQUEST_SIZE_INVALID"}
+        val req=JSONObject(raw);val command=req.getString("command")
+        val common=setOf("command","profileId","expectedRevision")
+        val actual=command=="recordLevemirActual"
+        require(command=="activate"||actual){"Q08_COMMAND_INVALID"}
+        val keys=req.keys().asSequence().toSet()
+        require(keys==if(actual)common+setOf("requestId","slot","units","occurredAtUtc","site") else common){"Q08_REQUEST_FIELDS_INVALID"}
+        require(req.opt("expectedRevision") is Number&&req.getDouble("expectedRevision")==req.getLong("expectedRevision").toDouble()&&req.getLong("expectedRevision")>=0){"Q08_REVISION_INVALID"}
+        val s=status();require(s.getBoolean("profileConfigured")){"PROFILE_UNCONFIGURED"}
+        require(req.getString("profileId")==s.getString("profileId")){"Q08_PROFILE_CONFLICT"}
+        val message=if(!actual){
+            require(s.getBoolean("canActivate")&&!s.getBoolean("active")){"Q08_ACTIVATION_NOT_AVAILABLE"}
+            require(req.getLong("expectedRevision")==s.getLong("revision")){"V3_REVISION_CONFLICT"}
+            "Включить запись Левемира через GFStorage? Включение не создаёт запись об уколе."
+        }else{
+            require(s.getBoolean("active")){"Q08_PRODUCER_NOT_ACTIVATED"}
+            require(req.opt("units") is Number){"Q08_DOSE_TYPE_INVALID"}
+            val requestId=req.getString("requestId");require(GfV3WriteContract.validId(requestId)&&requestId.length<=96){"Q08_REQUEST_ID_INVALID"}
+            val site=sites[req.getString("site")]?:throw IllegalArgumentException("Q08_SITE_INVALID")
+            val at=GfV3Q08Rules.parseUtc(req.getString("occurredAtUtc"));val slot=req.getString("slot")
+            GfV3Q08Rules.validateManual(req.getDouble("units"),site,slot,at,Instant.now())
+            val settings=storage.readShellPort("settings")
+            require(settings.getString("profileId")==req.getString("profileId")){"Q08_PROFILE_CONFLICT"}
+            val zone=java.time.ZoneId.of(settings.getJSONObject("data").getJSONObject("profile").getString("timeZone"))
+            val local=at.atZone(zone).format(java.time.format.DateTimeFormatter.ofPattern("dd.MM.uuuu HH:mm:ss XXX"))
+            "Подтвердите уже сделанный укол Левемира.\nКоличество: ${req.getDouble("units")} ЕД\nМесто: ${req.getString("site")}\nВремя: $local ($zone)\nЗапланированный укол не подтверждайте."
+        }
+        val ticket=UUID.randomUUID().toString()
+        synchronized(lock){require(!closed&&pending.isEmpty()){"Q08_BUSY"};pending[ticket]=Pending(req)}
+        try{onConfirm(message){approved->
+            val p=synchronized(lock){val x=pending[ticket];if(!closed&&x?.state=="PENDING"){if(!approved){x.state="CANCELLED";x.result=JSONObject().put("accepted",false).put("code","OWNER_CANCELLED");null}else{x.state="APPLYING";x}}else null}
+            if(p!=null)try{worker.execute{
+                try{val r=apply(p.request);finish(ticket,"FINISHED",r)}catch(e:Exception){finish(ticket,"REJECTED",JSONObject().put("accepted",false).put("code",e.message?:"Q08_NATIVE_REJECTED"))}
+            }}catch(_:Exception){finish(ticket,"REJECTED",JSONObject().put("accepted",false).put("code","Q08_WORKER_UNAVAILABLE"))}
+        }}catch(e:Exception){synchronized(lock){pending.remove(ticket)};throw e}
+        return JSONObject().put("ticket",ticket).put("state","PENDING")
+    }
+    private fun apply(r:JSONObject):JSONObject = if(r.getString("command")=="activate") {
+        installer.activateAfterAndroidDialog(r.getString("profileId"),r.getLong("expectedRevision"),true).put("accepted",true).put("activationOnly",true)
+    }else facts.confirm(r.getString("profileId"),r.getString("requestId"),r.getLong("expectedRevision"),r.getString("slot"),r.getDouble("units"),sites.getValue(r.getString("site")),r.getString("occurredAtUtc"),true)
+    private fun finish(ticket:String,state:String,result:JSONObject)=synchronized(lock){pending[ticket]?.let{if(!closed&&it.state=="APPLYING"){it.state=state;it.result=result}}}
+    fun poll(ticket:String):JSONObject=synchronized(lock){
+        require(ticket.length in 10..128){"Q08_TICKET_INVALID"}
+        val p=pending[ticket]?:return@synchronized JSONObject().put("state","UNKNOWN_TICKET")
+        JSONObject().put("state",p.state).also{if(p.state !in setOf("PENDING","APPLYING")){it.put("result",p.result?:JSONObject.NULL);pending.remove(ticket)}}
+    }
+    fun close(){synchronized(lock){closed=true;pending.clear()};worker.shutdown();worker.awaitTermination(5,TimeUnit.SECONDS)}
+}
