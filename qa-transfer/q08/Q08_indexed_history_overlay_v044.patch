+    /** Narrow Q08 research context. No unrelated coefficient/history payloads are loaded. */
+    internal fun readNativeQ08Context(moduleId:String):JSONObject=synchronized(lock){
+        require(moduleId=="GFLevemirReview"){"Q08_READ_OWNER_DENIED"}
+        val db=helper.readableDatabase
+        db.beginTransactionNonExclusive()
+        try {
+            validateNativeRead(db,"research",moduleId)
+            val m=meta(db);val id=m.profileId?:throw IllegalStateException("PROFILE_UNCONFIGURED")
+            val data=JSONObject().put("profile",JSONObject().put("profileId",id).put("timeZone",m.timezone))
+                .put("measurements",rows(db,"SELECT measurement_id,measured_at_utc,weight_kg,height_cm,created_revision FROM v3_measurements WHERE profile_id=? ORDER BY measured_at_utc DESC LIMIT 2000",id){c->JSONObject().put("measurementId",c.getString(0)).put("measuredAtUtc",c.getString(1)).put("weightKg",c.getDouble(2)).put("heightCm",c.getDouble(3)).put("createdRevision",c.getLong(4))})
+            db.setTransactionSuccessful()
+            JSONObject().put("schemaVersion",3).put("profileConfigured",true).put("profileId",id).put("revision",m.revision).put("inputRevision",m.inputRevision).put("data",data)
+        }finally{db.endTransaction()}
+    }
+    /** Indexed coarse UTC-date window. Caller post-filters exact timestamps, including fractions.
+     * Only the compile-time Q08 native port may call this method. Date range is derived from
+     * persisted profile zone and asOf, not arbitrary SQL or a WebView-supplied module ID.
+     */
+    internal fun readNativeQ08CgmPage(moduleId:String,profileId:String,expectedRevision:Long,afterRowId:Long,asOf:Instant,pageSize:Int):JSONObject=synchronized(lock){
+        require(moduleId=="GFLevemirReview"){"Q08_READ_OWNER_DENIED"}
+        require(pageSize in 1..500&&afterRowId>=0&&expectedRevision>=0){"PAGE_ARGUMENT_INVALID"}
+        val db=helper.readableDatabase
+        db.beginTransactionNonExclusive()
+        try {
+            validateNativeRead(db,"research",moduleId)
+            val m=meta(db)
+            require(m.profileId==profileId&&m.revision==expectedRevision){"Q08_PAGE_CONTEXT_CHANGED"}
+            val zone=ZoneId.of(m.timezone?:throw IllegalStateException("PROFILE_UNCONFIGURED"))
+            val from=asOf.atZone(zone).toLocalDate().minusDays(14).atStartOfDay(zone).toInstant().minusSeconds(3600)
+            val dayStart=from.atZone(java.time.ZoneOffset.UTC).toLocalDate().toString()
+            val dayEnd=asOf.atZone(java.time.ZoneOffset.UTC).toLocalDate().plusDays(1).toString()
+            val result=JSONArray();var last=afterRowId;var count=0;var more=false
+            db.rawQuery("SELECT rowid,payload_json,measured_at_utc FROM v3_cgm INDEXED BY idx_v3_cgm_profile_time WHERE profile_id=? AND measured_at_utc>=? AND measured_at_utc<? AND rowid>? ORDER BY rowid ASC LIMIT ?",arrayOf(profileId,dayStart,dayEnd,afterRowId.toString(),(pageSize+1).toString())).use{c->
+                while(c.moveToNext()){if(count>=pageSize){more=true;break};last=c.getLong(0);val item=JSONObject(c.getString(1));require(item.getString("measuredAtUtc")==c.getString(2)){"Q08_CGM_TIMESTAMP_INCONSISTENT"};result.put(item);count++}
+            }
+            db.setTransactionSuccessful()
+            JSONObject().put("schemaVersion",3).put("domain","cgm").put("profileId",profileId).put("revision",m.revision).put("rows",result).put("nextCursor",last).put("hasMore",more).put("complete",!more)
+        }finally{db.endTransaction()}
+    }
