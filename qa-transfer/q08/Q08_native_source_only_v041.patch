+package org.glukopapa.v3.m00
+
+import android.database.sqlite.SQLiteDatabase
+import org.json.JSONObject
+import java.time.Instant
+import java.time.ZoneId
+
+/** Native-only manual record contract. No dose calculation and no JavaScript writer. */
+internal object GfV3Q08InjectionContract {
+    fun actual(p: JSONObject, now: Instant = Instant.now()) {
+        require(p.optString("eventType") == "insulin_injection" && p.optString("status") == "confirmed" &&
+            p.optString("provenance") == "CONFIRMED_ACTUAL" && p.optBoolean("userConfirmed",false) &&
+            p.optString("insulinId") == "levemir" && p.optString("insulinClass") == "basal" &&
+            p.optString("confirmationSource") == "ANDROID_OWNER_UI") { "Q08_NOT_CONFIRMED_LEVEMIR" }
+        require(p.opt("units") is Number) { "Q08_DOSE_TYPE_INVALID" }
+        val slot = p.getString("levemirSlot")
+        val at = GfV3WriteContract.requireUtc(p.getString("occurredAtUtc"))
+        if (slot == GfV3Q08Rules.EXTRA_SLOT) {
+            require(p.optBoolean("additionalActual", false)) { "Q08_EXTRA_EXPLICIT_REQUIRED" }
+            GfV3Q08Rules.validateExtra(p.getDouble("units"),p.getString("injectionSite"),at,now,p.optString("additionalReason"))
+        } else {
+            require(!p.has("additionalActual") && !p.has("additionalReason")) { "Q08_EXTRA_FLAG_ON_REGULAR" }
+            GfV3Q08Rules.validateManual(p.getDouble("units"),p.getString("injectionSite"),slot,at,now)
+        }
+    }
+    /** Run inside the same SQLite write transaction as append or correction. */
+    fun requireUniqueSlot(db: SQLiteDatabase, profile: String, event: JSONObject, excludeId: String? = null) {
+        val zone = db.rawQuery("SELECT timezone FROM v3_meta WHERE id=1 AND profile_id=?", arrayOf(profile)).use { c ->
+            require(c.moveToFirst() && !c.isNull(0)) { "Q08_PROFILE_CONFLICT" }; ZoneId.of(c.getString(0))
+        }
+        val at = GfV3WriteContract.requireUtc(event.getString("occurredAtUtc"))
+        val slot = event.getString("levemirSlot")
+        // Request idempotency and event ID uniqueness remain enforced by the writer.
+        // Extra facts must not be rejected just because another real injection occupied the day.
+        if (slot == GfV3Q08Rules.EXTRA_SLOT) return
+        db.rawQuery("SELECT event_id,payload_json FROM v3_events WHERE profile_id=? AND event_type='insulin_injection' AND event_status='confirmed'",arrayOf(profile)).use { c ->
+            while(c.moveToNext()) {
+                if(c.getString(0)==excludeId) continue
+                val existing=JSONObject(c.getString(1))
+                if(!GfV3Q08Rules.isLevemir(existing.optString("insulinId"))) continue
+                val otherAt=GfV3WriteContract.requireUtc(existing.getString("occurredAtUtc"))
+                if(GfV3Q08Rules.localDay(at,zone)!=GfV3Q08Rules.localDay(otherAt,zone)) continue
+                val otherSlot=existing.optString("levemirSlot")
+                if(otherSlot==GfV3Q08Rules.EXTRA_SLOT) continue
+                require(otherSlot in GfV3Q08Rules.slots) { "Q08_LEGACY_SLOT_UNRESOLVED" }
+                require(!GfV3Q08Rules.sameSlot(at,slot,otherAt,otherSlot,zone)) { "Q08_SLOT_ALREADY_RECORDED" }
+            }
+        }
+    }
+}
+internal class GfV3Q08InjectionFacts(private val port: GfV3NativeModuleGateway.BoundPort) {
+    /** approved must be supplied only by a trusted native user-action handler, never a JS field. */
+    fun confirm(profile: String, requestId: String, revision: Long, slot: String, units: Double, site: String,
+                atUtc: String, approved: Boolean): JSONObject {
+        require(slot in GfV3Q08Rules.slots) { "Q08_INVALID_SITE_OR_SLOT" }
+        return record(profile,requestId,revision,slot,units,site,atUtc,approved,null)
+    }
+    /** For a separately confirmed actual extra injection, never for advice or scheduling. */
+    fun confirmAdditionalActual(profile: String, requestId: String, revision: Long, units: Double, site: String,
+                                atUtc: String, reason: String, approved: Boolean): JSONObject =
+        record(profile,requestId,revision,GfV3Q08Rules.EXTRA_SLOT,units,site,atUtc,approved,reason)
+
+    private fun record(profile: String, requestId: String, revision: Long, slot: String, units: Double,
+                       site: String, atUtc: String, approved: Boolean, extraReason: String?): JSONObject {
+        if(!approved) throw SecurityException("Q08_NATIVE_OWNER_REQUIRED")
+        require(GfV3WriteContract.validId(requestId) && requestId.length<=96) { "Q08_REQUEST_ID_INVALID" }
+        val eventId="q08-event-$requestId"
+        val p=JSONObject().put("eventId",eventId).put("profileId",profile).put("eventType","insulin_injection")
+            .put("status","confirmed").put("provenance","CONFIRMED_ACTUAL").put("userConfirmed",true)
+            .put("insulinId","levemir").put("insulinClass","basal").put("levemirSlot",slot)
+            .put("units",units).put("injectionSite",site).put("occurredAtUtc",atUtc).put("confirmationSource","ANDROID_OWNER_UI")
+        if(extraReason != null) p.put("additionalActual",true).put("additionalReason",extraReason.trim())
+        GfV3Q08InjectionContract.actual(p)
+        val out=port.append("actionWriter","q08-write-$requestId",revision,p)
+        return JSONObject().put("accepted",true).put("eventId",out.getString("recordId")).put("revision",out.getLong("revision")).put("created",out.getBoolean("created"))
+    }
+}
