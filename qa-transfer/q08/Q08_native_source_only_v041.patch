+package org.glukopapa.v3.m00
+
+import java.time.Instant
+import java.time.ZoneId
+
+/** Non-clinical validation of manually entered historical facts and consistent read pages. */
+internal object GfV3Q08Rules {
+    const val OWNER = "GFLevemirReview"
+    val slots = setOf("morning", "evening")
+    const val EXTRA_SLOT = "additional"
+    val recordedSlots = slots + EXTRA_SLOT
+    val sites = setOf("abdomen", "arm", "thigh", "buttock")
+    fun isLevemir(insulin: String) = insulin.equals("levemir", ignoreCase = true)
+    fun checkDose(units: Double) {
+        require(units.isFinite() && units in 0.5..100.0 && units * 2 == kotlin.math.floor(units * 2)) { "Q08_INVALID_MANUAL_DOSE" }
+    }
+    fun localDay(at: Instant, zone: ZoneId) = at.atZone(zone).toLocalDate()
+    fun startOfHistory(asOf: Instant, zone: ZoneId): Instant =
+        localDay(asOf,zone).minusDays(14).atStartOfDay(zone).toInstant().minusSeconds(3600)
+    fun validateManual(units: Double, site: String, slot: String, at: Instant, now: Instant) {
+        checkDose(units)
+        require(site in sites && slot in slots) { "Q08_INVALID_SITE_OR_SLOT" }
+        require(!at.isAfter(now)) { "Q08_FUTURE_ACTION" }
+    }
+    /** A separate native action records an already administered extra fact, not a scheduled dose. */
+    fun validateExtra(units: Double, site: String, at: Instant, now: Instant, reason: String) {
+        checkDose(units)
+        require(site in sites) { "Q08_INVALID_SITE_OR_SLOT" }
+        require(!at.isAfter(now)) { "Q08_FUTURE_ACTION" }
+        require(reason.trim().length in 3..500) { "Q08_EXTRA_REASON_REQUIRED" }
+    }
+    fun sameSlot(a: Instant, aSlot: String, b: Instant, bSlot: String, zone: ZoneId): Boolean =
+        aSlot == bSlot && localDay(a,zone) == localDay(b,zone)
+    data class PageMeta(val profile: String, val revision: Long, val domain: String, val nextCursor: Long, val count: Int, val hasMore: Boolean, val complete: Boolean)
+    fun validatePage(p: PageMeta, profile: String, revision: Long, domain: String, cursor: Long) {
+        require(p.profile == profile && p.revision == revision && p.domain == domain) { "Q08_PAGE_CONTEXT_CHANGED" }
+        require(p.count in 0..500 && p.nextCursor >= cursor && p.complete != p.hasMore) { "Q08_PAGE_INVALID" }
+        require(if(p.count == 0) !p.hasMore && p.nextCursor == cursor else p.nextCursor > cursor) { "Q08_PAGE_CURSOR_INVALID" }
+    }
+}
