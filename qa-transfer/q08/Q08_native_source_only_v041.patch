+package org.glukopapa.v3.m00
+
+import org.json.JSONArray
+import org.json.JSONObject
+import java.time.Instant
+import java.time.ZoneId
+
+/** Native-only reader. Reuses GFStorage's revision-pinned pagination, never guesses coverage. */
+internal class GfV3Q08History(private val port: GfV3NativeModuleGateway.BoundPort,
+                              private val storage: GfV3Storage) {
+    fun read(asOf: Instant = Instant.now()): JSONObject {
+        val snap = port.read("research") // existing registry permission gate
+        require(snap.getBoolean("profileConfigured")) { "PROFILE_UNCONFIGURED" }
+        val profile = snap.getString("profileId")
+        val revision = snap.getLong("revision")
+        val data = snap.getJSONObject("data")
+        val zone = ZoneId.of(data.getJSONObject("profile").getString("timeZone"))
+        val from = GfV3Q08Rules.startOfHistory(asOf, zone)
+        // Read all pages, filter only after parsing the actual UTC timestamp. Never silently truncate.
+        val domains = listOf("cgm", "events", "mealSessions")
+        for (domain in domains) {
+            var cursor = 0L
+            var total = 0
+            val result = JSONArray()
+            do {
+                val p = storage.readShellPage(domain,cursor,revision,500)
+                val rows = p.getJSONArray("rows")
+                val meta = GfV3Q08Rules.PageMeta(p.getString("profileId"),p.getLong("revision"),p.getString("domain"),p.getLong("nextCursor"),rows.length(),p.getBoolean("hasMore"),p.getBoolean("complete"))
+                GfV3Q08Rules.validatePage(meta,profile,revision,domain,cursor)
+                total += rows.length()
+                require(total <= 250000) { "Q08_HISTORY_BUDGET_EXCEEDED" }
+                for (i in 0 until rows.length()) {
+                    val row = rows.getJSONObject(i)
+                    val raw = when(domain) {
+                        "cgm" -> row.getString("measuredAtUtc")
+                        "events" -> row.getString("occurredAtUtc")
+                        else -> row.optString("startedAtUtc")
+                    }
+                    // A meal without a confirmed start is retained for diagnostics, not inferred.
+                    if(domain == "mealSessions" && raw.isBlank()) { result.put(row); continue }
+                    val at = GfV3WriteContract.requireUtc(raw)
+                    // Keep basal history for last site and duplicate diagnostics; other events are not needed here.
+                    if(!at.isAfter(asOf) && ((domain == "events" && GfV3Q08Rules.isLevemir(row.optString("insulinId"))) || (!at.isBefore(from) && domain != "events"))) result.put(row)
+                }
+                cursor = meta.nextCursor
+            } while(meta.hasMore)
+            data.put(domain,result)
+        }
+        val finalContext = port.read("research") // recheck native grant as well as profile / revision
+        require(finalContext.getString("profileId")==profile && finalContext.getLong("revision")==revision && storage.revision()==revision) { "Q08_PAGE_CONTEXT_CHANGED" }
+        data.put("q08ReadWindow", JSONObject().put("startUtc",from.toString()).put("endUtc",asOf.toString()).put("allStoredPagesRead",true).put("sensorCoverageProven",false))
+        return snap
+    }
+}
