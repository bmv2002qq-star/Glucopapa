+package org.glukopapa.v3.m00
+
+import android.app.Activity
+import android.app.Instrumentation
+
+/** QA-only: finish the WebView Activity AND wait until its SQLite helper is closed.
+ * Calling finish() alone is asynchronous and deleting the shared SQLite file
+ * before onDestroy() causes SQLITE_IOERR_SHORT_READ in the following test class.
+ */
+internal object GfV3QaActivityLifecycle {
+    fun finishAndAwait(instrument: Instrumentation, activity: Activity) {
+        instrument.runOnMainSync { activity.finish() }
+        repeat(80) {
+            instrument.waitForIdleSync()
+            if (activity.isDestroyed) return
+            Thread.sleep(100)
+        }
+        check(activity.isDestroyed) { "Q07_QA_ACTIVITY_NOT_DESTROYED_BEFORE_DB_RESET" }
+    }
+}
