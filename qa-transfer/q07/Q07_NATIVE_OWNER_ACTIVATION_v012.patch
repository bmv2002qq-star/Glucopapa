+package org.glukopapa.v3.m00
+
+import androidx.test.ext.junit.runners.AndroidJUnit4
+import androidx.test.platform.app.InstrumentationRegistry
+import org.json.JSONObject
+import org.junit.After
+import org.junit.Assert.*
+import org.junit.Before
+import org.junit.Test
+import org.junit.runner.RunWith
+
+/** Real Android owner activation and GFStorage registry transaction tests. */
+@RunWith(AndroidJUnit4::class)
+class Q07RinFastModuleInstallerInstrumentedTest {
+    private val ctx get() = InstrumentationRegistry.getInstrumentation().targetContext
+    private lateinit var helper:GfDbHelper
+    private lateinit var storage:GfV3Storage
+    private lateinit var installer:GfV3Q07ModuleInstaller
+    @Before fun before() {
+        InstrumentationRegistry.getInstrumentation().waitForIdleSync()
+        ctx.deleteDatabase("glukopapa_v3.db")
+        helper=GfDbHelper(ctx)
+        storage=GfV3Storage(helper,
+            ctx.assets.open("db/module_catalog_v1.json").bufferedReader().use { it.readText() },
+            ctx.assets.open("db/writer_grants_v0.12.json").bufferedReader().use { it.readText() })
+        installer=GfV3Q07ModuleInstaller(helper)
+        helper.writableDatabase.execSQL("UPDATE v3_meta SET profile_id='q07-installer-profile',timezone='UTC' WHERE id=1")
+    }
+    @After fun after() {helper.close();ctx.deleteDatabase("glukopapa_v3.db")}
+    private fun rev()=storage.revision()
+    private fun count(table:String):Long=helper.readableDatabase.rawQuery("SELECT COUNT(*) FROM $table",null).use {c->
+        assertTrue(c.moveToFirst());c.getLong(0)
+    }
+    private fun state():JSONObject {
+        val a=storage.readShellPort("registry").getJSONObject("data").getJSONArray("modules")
+        return (0 until a.length()).map(a::getJSONObject).single{it.getString("moduleId")=="GFInjectionFact"}
+    }
+    private fun reject(action:()->Unit) {
+        try {action();fail("Q07_INSTALLER_SHOULD_REJECT")}
+        catch(e:SecurityException) {} catch(e:IllegalArgumentException) {} catch(e:IllegalStateException) {}
+    }
+    @Test fun installingIsNeverAutomaticAndDoesNotWriteAnInjection() {
+        assertEquals("NOT_CONNECTED",state().getString("status"))
+        assertFalse(state().getBoolean("featureEnabled"))
+        assertEquals(0L,count("v3_events"))
+        val old=rev();val priorAudit=count("v3_audit")
+        reject {installer.activateAfterAndroidDialog(old,false)}
+        assertEquals(old,rev());assertEquals(priorAudit,count("v3_audit"))
+        assertEquals(0L,count("v3_events"))
+    }
+    @Test fun explicitNativeOwnerApprovalActivatesOnlyQ07WithoutMedicalInput() {
+        val before=rev();val priorAudit=count("v3_audit");val priorFeed=count("v3_change_feed")
+        val installed=installer.activateAfterAndroidDialog(before,true)
+        assertTrue(installed.getBoolean("activated"));assertFalse(installed.getBoolean("injectionRecorded"))
+        assertEquals(before+1,installed.getLong("revision"));assertEquals(before+1,rev())
+        assertEquals("OWNER_INTEGRATION_ACCEPTED",state().getString("status"))
+        assertTrue(state().getBoolean("featureEnabled"))
+        assertEquals("v0.1.2",state().getString("version"))
+        assertEquals(1, state().getJSONArray("writeRoles").length())
+        assertEquals("actionWriter",state().getJSONArray("writeRoles").getString(0))
+        assertEquals(priorAudit+1,count("v3_audit"));assertEquals(priorFeed+1,count("v3_change_feed"))
+        assertEquals(0L,count("v3_events"));assertEquals(0L,count("v3_write_receipts"))
+        assertEquals(0L,count("v3_record_corrections"))
+        val audit=helper.readableDatabase.rawQuery(
+            "SELECT action,source_module FROM v3_audit WHERE revision=?",arrayOf((before+1).toString())
+        ).use {c->assertTrue(c.moveToFirst());Pair(c.getString(0),c.getString(1))}
+        assertEquals("Q07_OWNER_DIALOG_ACTIVATION",audit.first)
+        assertEquals("GFShell",audit.second)
+    }
+    @Test fun staleRevisionOrMissingGrantCannotActivate() {
+        val r=rev();reject {installer.activateAfterAndroidDialog(r+1,true)}
+        helper.writableDatabase.execSQL("DELETE FROM v3_write_grants WHERE module_id='GFInjectionFact'")
+        reject {installer.activateAfterAndroidDialog(r,true)}
+        assertEquals(r,rev());assertEquals("NOT_CONNECTED",state().getString("status"))
+        assertEquals(0L,count("v3_events"))
+    }
+    @Test fun illegalWidenedRolesCannotActivateAndDoNotPartiallyWrite() {
+        val r=rev()
+        helper.writableDatabase.execSQL("UPDATE v3_module_registry SET write_roles_json='[\"actionWriter\",\"forecastWriter\"]' WHERE module_id='GFInjectionFact'")
+        reject {installer.activateAfterAndroidDialog(r,true)}
+        assertEquals(r,rev());assertFalse(state().getBoolean("featureEnabled"))
+    }
+    @Test fun activationIsIdempotentAndRejectsStaleRequests() {
+        val r=rev()
+        installer.activateAfterAndroidDialog(r,true)
+        val again=installer.activateAfterAndroidDialog(r+1,true)
+        assertFalse(again.getBoolean("activated"));assertTrue(again.getBoolean("alreadyActive"))
+        assertEquals(r+1,rev())
+        reject {installer.activateAfterAndroidDialog(r,true)}
+        assertEquals(r+1,rev())
+    }
+    @Test fun actualRinFastCannotAppearWithoutSecondOwnerConfirmation() {
+        val before=rev()
+        installer.activateAfterAndroidDialog(before,true)
+        val gateway=GfV3NativeModuleGateway(storage,GfV3NativeWriter(helper),GfV3CorrectionWriter(helper),helper)
+        val facts=GfV3Q07InjectionFacts(gateway.bindInstalledAdapter("GFInjectionFact"))
+        reject {facts.confirm("q07-install-test-1","q07-install-key-1",1.0,"abdomen",
+            "2026-11-24T12:00:00Z","",rev(),false)}
+        assertEquals(0L,count("v3_events"))
+        val ok=facts.confirm("q07-install-test-1","q07-install-key-1",1.0,"abdomen",
+            "2026-11-24T12:00:00Z","",rev(),true)
+        assertTrue(ok.getBoolean("created"));assertEquals(1L,count("v3_events"))
+        val queue=GfV3Q07OwnerQueue(facts,storage){_,done->done(false)}
+        try {
+            assertEquals("UNKNOWN_INCOMPLETE_COVERAGE",queue.snapshot().getString("iobStatus"))
+            assertTrue(queue.snapshot().isNull("modelRemainingUnits"))
+        } finally { queue.close() }
+    }
+
+    private fun activationQueueResponse(approve:Boolean):JSONObject {
+        val gateway=GfV3NativeModuleGateway(storage,GfV3NativeWriter(helper),GfV3CorrectionWriter(helper),helper)
+        val facts=GfV3Q07InjectionFacts(gateway.bindInstalledAdapter("GFInjectionFact"))
+        val queue=GfV3Q07OwnerQueue(facts,storage,installer){_,done->done(approve)}
+        try {
+            val before=queue.snapshot()
+            val request=JSONObject().put("command","confirm")
+                .put("profileId",before.getString("profileId"))
+                .put("expectedRevision",before.getLong("revision"))
+                .put("units",1.0).put("site","abdomen")
+                .put("atUtc",java.time.Instant.now().minusSeconds(120).toString()).put("note","")
+            val ticket=queue.enqueue(request.toString()).getString("ticket")
+            var poll=JSONObject()
+            for(i in 0..70) {
+                poll=queue.poll(ticket)
+                if (poll.getString("state") !in setOf("PENDING","APPLYING")) break
+                Thread.sleep(40)
+            }
+            assertTrue(poll.getString("state") !in setOf("PENDING","APPLYING"))
+            return poll
+        } finally {queue.close()}
+    }
+    @Test fun firstUseOwnerDialogActivatesWithoutRecordingShot() {
+        val result=activationQueueResponse(true)
+        assertEquals("FINISHED",result.getString("state"))
+        assertTrue(result.getJSONObject("result").getBoolean("accepted"))
+        assertTrue(result.getJSONObject("result").getBoolean("activationOnly"))
+        assertEquals("Q07_ACTIVATED_RECONFIRM_SHOT",result.getJSONObject("result").getString("code"))
+        assertEquals("OWNER_INTEGRATION_ACCEPTED",state().getString("status"))
+        assertEquals(0L,count("v3_events"))
+        assertEquals(0L,count("v3_write_receipts"))
+    }
+    @Test fun nativeCancelNeverActivatesAndNeverRecords() {
+        val old=rev()
+        val result=activationQueueResponse(false)
+        assertEquals("CANCELLED",result.getString("state"))
+        assertEquals(old,rev())
+        assertEquals("NOT_CONNECTED",state().getString("status"))
+        assertEquals(0L,count("v3_events"))
+    }
+}
