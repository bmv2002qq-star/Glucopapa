+/**
+ * Q07: explicit Android-owner-initiated module activation. No injection is created.
+ * Never invoke during startup or interpret a browser-supplied boolean as consent.
+ */
+internal class GfV3Q07ModuleInstaller(private val helper: GfDbHelper) {
+    companion object {
+        const val MODULE = "GFInjectionFact"
+        const val VERSION = "v0.1.2"
+    }
+
+    fun activateAfterAndroidDialog(expectedRevision: Long, nativeOwnerApproved: Boolean): JSONObject {
+        if (!nativeOwnerApproved) throw SecurityException("Q07_ACTIVATION_REQUIRES_ANDROID_OWNER")
+        require(expectedRevision >= 0) { "Q07_ACTIVATION_REVISION_INVALID" }
+        val db = helper.writableDatabase
+        db.beginTransaction()
+        try {
+            val meta = db.rawQuery("SELECT revision,profile_id,input_revision FROM v3_meta WHERE id=1", null).use { c ->
+                if (!c.moveToFirst()) throw IllegalStateException("V3_META_MISSING")
+                Triple(c.getLong(0), if (c.isNull(1)) null else c.getString(1), c.getLong(2))
+            }
+            if (meta.second == null) throw IllegalStateException("PROFILE_UNCONFIGURED")
+            if (meta.first != expectedRevision) throw IllegalStateException("V3_REVISION_CONFLICT")
+            val state = db.rawQuery(
+                "SELECT status,feature_enabled,write_roles_json FROM v3_module_registry WHERE module_id=?",
+                arrayOf(MODULE)
+            ).use { c ->
+                if (!c.moveToFirst()) throw SecurityException("Q07_MODULE_NOT_IN_CATALOG")
+                Triple(c.getString(0), c.getInt(1), c.getString(2))
+            }
+            if (state.first == "OWNER_INTEGRATION_ACCEPTED" && state.second == 1) {
+                db.setTransactionSuccessful()
+                return JSONObject().put("activated", false).put("alreadyActive", true)
+                    .put("revision", meta.first).put("moduleId", MODULE)
+            }
+            if (state.first != "NOT_CONNECTED" || state.second != 0)
+                throw SecurityException("Q07_ACTIVATION_ILLEGAL_REGISTRY_STATE")
+            val roles = JSONArray(state.third)
+            if ((0 until roles.length()).map { roles.getString(it) }.toSet() != setOf("actionWriter"))
+                throw SecurityException("Q07_ACTIVATION_WRITE_ROLES_INVALID")
+            val granted = db.rawQuery(
+                "SELECT 1 FROM v3_write_grants WHERE module_id=? AND role='actionWriter' " +
+                    "AND grant_status='OWNER_GRANTED_EXPERIMENTAL' " +
+                    "AND implementation_status='PREPARED_NATIVE' LIMIT 1", arrayOf(MODULE)
+            ).use { it.moveToFirst() }
+            if (!granted) throw SecurityException("Q07_ACTIVATION_GRANT_NOT_READY")
+
+            val next = meta.first + 1
+            val update = db.update("v3_module_registry", ContentValues().apply {
+                put("status", "OWNER_INTEGRATION_ACCEPTED")
+                put("feature_enabled", 1)
+                put("version", VERSION)
+                put("adapter_version", VERSION)
+                put("read_roles_json", "[\"journal\"]")
+                // Do not widen or invent additional write privileges.
+            }, "module_id=? AND status='NOT_CONNECTED' AND feature_enabled=0", arrayOf(MODULE))
+            if (update != 1) throw IllegalStateException("Q07_ACTIVATION_REGISTRY_CAS_FAILED")
+            val m = db.update("v3_meta", ContentValues().apply { put("revision", next) },
+                "id=1 AND revision=?", arrayOf(meta.first.toString()))
+            if (m != 1) throw IllegalStateException("Q07_ACTIVATION_REVISION_CAS_FAILED")
+            val now = Instant.now().toString()
+            db.insertOrThrow("v3_audit", null, ContentValues().apply {
+                put("revision", next);put("domain", "registry");put("record_id", MODULE)
+                put("action", "Q07_OWNER_DIALOG_ACTIVATION");put("source_module", "GFShell")
+                put("at_utc", now)
+            })
+            db.insertOrThrow("v3_change_feed", null, ContentValues().apply {
+                put("revision", next);put("domain", "registry");put("record_id", MODULE)
+                put("source_module", "GFShell");put("created_at_utc", now)
+            })
+            db.setTransactionSuccessful()
+            return JSONObject().put("activated", true).put("alreadyActive", false)
+                .put("revision", next).put("moduleId", MODULE)
+                .put("injectionRecorded", false).put("inputRevisionUnchanged", meta.third)
+        } finally { db.endTransaction() }
+    }
+}
