+package org.glukopapa.v3.m00
+
+import org.json.JSONObject
+import java.time.Instant
+
+/** Q07: exact pen-step and trust-boundary checks, NOT a dose calculator. */
+internal object GfV3Q07InjectionContract {
+    val sites = setOf("abdomen", "arm", "thigh", "buttock")
+    fun dose(units: Double) {
+        require(units.isFinite() && units >= 0.5 && units <= 100.0 &&
+            kotlin.math.abs(units * 2.0 - kotlin.math.round(units * 2.0)) < 1e-8) {
+            "Q07_RINFAST_PEN_STEP_INVALID"
+        }
+    }
+    fun actual(payload: JSONObject, now: Instant = Instant.now()) {
+        require(payload.optString("eventType") == "insulin_injection" &&
+            payload.optString("status") == "confirmed" &&
+            payload.optString("provenance") == "CONFIRMED_ACTUAL" &&
+            payload.optBoolean("userConfirmed", false) &&
+            payload.optString("insulinId") == "rinfast") { "Q07_NOT_CONFIRMED_RINFAST" }
+        dose(payload.getDouble("units"))
+        require(payload.getString("injectionSite") in sites) { "Q07_SITE_INVALID" }
+        val at = GfV3WriteContract.requireUtc(payload.getString("occurredAtUtc"))
+        require(!at.isAfter(now.plusSeconds(60))) { "Q07_FUTURE_ACTION_REJECTED" }
+        require(payload.optString("note").length <= 150) { "Q07_NOTE_INVALID" }
+    }
+}
