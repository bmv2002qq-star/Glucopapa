+package org.glukopapa.v3.m00
+
+import org.json.JSONArray
+import org.json.JSONObject
+import java.util.UUID
+import java.util.concurrent.Executors
+
+/** JS may request and poll, but only native UI consent + installed GFInjectionFact can write. */
+internal class GfV3Q07OwnerQueue(
+    private val facts: GfV3Q07InjectionFacts,
+    private val storage: GfV3Storage,
+    private val onConfirm: (String,(Boolean)->Unit)->Unit
+) {
+    private data class Pending(val request: JSONObject, val eventId: String,
+        val key: String, var state: String = "PENDING", var result: JSONObject? = null)
+    private val lock=Any()
+    private val pending=linkedMapOf<String,Pending>()
+    private val worker=Executors.newSingleThreadExecutor { r -> Thread(r,"Q07InjectionOwnerWorker").apply { isDaemon=true } }
+    private var closed=false
+
+    fun snapshot(): JSONObject {
+        // Journal returns one profile / one revision. No independent DB or mixed snapshots.
+        val journal=storage.readShellPort("journal")
+        val entries=journal.getJSONObject("data").getJSONArray("events")
+        val shots=JSONArray()
+        for (i in 0 until entries.length()) {
+            val e=entries.getJSONObject(i)
+            if(e.optString("eventType")=="insulin_injection" && e.optString("insulinId")=="rinfast") {
+                // Version and source are enriched inside the SAME SQLite journal read transaction.
+                // Do not mix a truncated corrections feed with the event snapshot.
+                require(e.optString("sourceModule")=="GFInjectionFact") { "Q07_EVENT_OWNER_MISMATCH" }
+                shots.put(JSONObject(e.toString()))
+            }
+        }
+        return JSONObject().put("revision",journal.getLong("revision"))
+            .put("profileId",journal.opt("profileId"))
+            .put("profileConfigured",journal.getBoolean("profileConfigured"))
+            .put("shots",shots)
+            .put("iobStatus","UNKNOWN_INCOMPLETE_COVERAGE")
+            .put("modelRemainingUnits",JSONObject.NULL)
+            .put("coverageProven",false)
+            .put("numericActivityEffectEnabled",false)
+    }
+
+    fun enqueue(raw: String): JSONObject {
+        require(raw.length in 20..2500) { "Q07_REQUEST_SIZE_INVALID" }
+        val request=JSONObject(raw)
+        val command=request.getString("command")
+        require(command in setOf("confirm","correct")) { "Q07_COMMAND_INVALID" }
+        val snap=snapshot()
+        require(snap.getBoolean("profileConfigured")) { "PROFILE_UNCONFIGURED" }
+        require(request.getLong("expectedRevision")==snap.getLong("revision")) { "V3_REVISION_CONFLICT" }
+        require(request.getString("profileId")==snap.getString("profileId")) { "Q07_PROFILE_CONFLICT" }
+        // Early gate is advisory; GFStorage rechecks registry and grant in SQL transaction.
+        val reg=storage.readShellPort("registry").getJSONObject("data")
+        val modules=reg.getJSONArray("modules")
+        val permitted=(0 until modules.length()).any { i ->
+            val m=modules.getJSONObject(i)
+            m.getString("moduleId")=="GFInjectionFact" &&
+                m.getString("status")=="OWNER_INTEGRATION_ACCEPTED" &&
+                m.getBoolean("featureEnabled") &&
+                (0 until m.getJSONArray("writeRoles").length()).any { j ->
+                    m.getJSONArray("writeRoles").getString(j)=="actionWriter" }
+        }
+        require(permitted) { "Q07_PRODUCER_NOT_ACTIVATED" }
+        val units=request.getDouble("units")
+        val site=request.getString("site")
+        GfV3Q07InjectionContract.dose(units)
+        require(site in GfV3Q07InjectionContract.sites) { "Q07_SITE_INVALID" }
+        if(command=="confirm") {
+            GfV3WriteContract.requireUtc(request.getString("atUtc"))
+            require(!java.time.Instant.parse(request.getString("atUtc")).isAfter(java.time.Instant.now().plusSeconds(60)))
+                { "Q07_FUTURE_ACTION_REJECTED" }
+            require(request.optString("note").length<=150) { "Q07_NOTE_INVALID" }
+        }else{
+            require(GfV3WriteContract.validId(request.getString("eventId"))) { "Q07_EVENT_ID_INVALID" }
+            require(request.getInt("recordVersion")>=0) { "Q07_EDIT_VERSION_INVALID" }
+            require(request.getString("reason").trim().length in 3..500) { "Q07_EDIT_REASON_REQUIRED" }
+        }
+        val desc=if(command=="confirm")
+            "Подтвердите, что РинФаст фактически введён.\nДоза: $units ЕД\nМесто: $site\nВремя: ${request.getString("atUtc")}.\nНе подтверждайте запланированный укол."
+            else "Подтвердите исправление ранее сделанного укола ${request.getString("eventId")}.\nНовая доза: $units ЕД\nМесто: $site\nПричина: ${request.getString("reason")}."
+        val ticket=UUID.randomUUID().toString()
+        val p=Pending(request,if(command=="confirm")"q07-event-${UUID.randomUUID()}" else request.getString("eventId"),
+            "q07-write-${UUID.randomUUID()}")
+        synchronized(lock) { require(!closed && pending.isEmpty()) { "Q07_BUSY" }; pending[ticket]=p }
+        try {
+            onConfirm(desc) { approved ->
+                if(!approved)finish(ticket,"CANCELLED",JSONObject().put("accepted",false).put("code","OWNER_CANCELLED"))
+                else {
+                    val reserved=synchronized(lock){pending[ticket]?.let{
+                        if(!closed&&it.state=="PENDING"){it.state="APPLYING";true}else false}?:false}
+                    if(reserved) try { worker.execute {
+                        try {
+                            val out=apply(p)
+                            finish(ticket,"FINISHED",JSONObject().put("accepted",true)
+                                .put("revision",out.getLong("revision")).put("recordId",p.eventId))
+                        } catch(e:Exception) {
+                            finish(ticket,"REJECTED",JSONObject().put("accepted",false)
+                                .put("code",e.message?:"Q07_NATIVE_WRITE_REJECTED"))
+                        }
+                    }} catch(_:Exception) { finish(ticket,"REJECTED",JSONObject().put("accepted",false)
+                        .put("code","Q07_WORKER_UNAVAILABLE")) }
+                }
+            }
+        }catch(e:Exception){synchronized(lock){pending.remove(ticket)};throw e}
+        return JSONObject().put("ticket",ticket).put("state","PENDING")
+    }
+    private fun apply(p: Pending): JSONObject {
+        val req=p.request
+        return if(req.getString("command")=="confirm") facts.confirm(p.eventId,p.key,
+            req.getDouble("units"),req.getString("site"),req.getString("atUtc"),
+            req.optString("note"),req.getLong("expectedRevision"),true)
+        else facts.correct(p.eventId,"q07-corr-${UUID.randomUUID()}",p.key,
+            req.getLong("expectedRevision"),req.getInt("recordVersion"),
+            req.getDouble("units"),req.getString("site"),req.getString("reason"),true)
+    }
+    private fun finish(ticket:String,state:String,result:JSONObject) = synchronized(lock) {
+        pending[ticket]?.let { if(!closed && it.state in setOf("PENDING","APPLYING")) {
+            it.state=state;it.result=result
+        }}
+    }
+    fun poll(ticket:String):JSONObject = synchronized(lock) {
+        require(ticket.length in 10..128) { "Q07_TICKET_INVALID" }
+        val p=pending[ticket]?:return@synchronized JSONObject().put("state","UNKNOWN_TICKET")
+        JSONObject().put("state",p.state).also { x ->
+            if(p.state !in setOf("PENDING","APPLYING")) {
+                x.put("result",p.result?:JSONObject.NULL);pending.remove(ticket)
+            }+        }
+    }
+    fun close() { synchronized(lock){closed=true;pending.clear()};worker.shutdownNow() }
+}
