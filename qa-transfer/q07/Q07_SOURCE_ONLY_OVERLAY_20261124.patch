+package org.glukopapa.v3.m00
+
+import android.webkit.JavascriptInterface
+import org.json.JSONObject
+
+/** Request-only Q07 WebView adapter: no direct SQL/writer, module identity or coverage toggle. */
+internal class GfV3Q07Bridge(private val owner: GfV3Q07OwnerQueue) {
+    @JavascriptInterface fun readState(): String = try { owner.snapshot().toString() } catch(e:Exception) { fail(e) }
+    @JavascriptInterface fun requestOwnerAction(raw: String): String = try { owner.enqueue(raw).toString() } catch(e:Exception) { fail(e) }
+    @JavascriptInterface fun pollOwnerAction(ticket: String): String = try { owner.poll(ticket).toString() } catch(e:Exception) { fail(e) }
+    private fun fail(e:Exception):String = JSONObject().put("error",JSONObject().put("code",e.message?:"Q07_ERROR")).toString()
+}
