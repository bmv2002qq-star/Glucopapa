+package org.glukopapa.v3.m00
+
+import org.json.JSONObject
+import java.time.Instant
+
+/** Q07 native-only owner. Independent of the RinFast research engine. */
+internal class GfV3Q07InjectionFacts(private val port: GfV3NativeModuleGateway.BoundPort) {
+    fun confirm(eventId: String, key: String, units: Double, site: String,
+                atUtc: String, note: String, revision: Long,
+                ownerConfirmedByAndroid: Boolean): JSONObject {
+        if (!ownerConfirmedByAndroid) throw SecurityException("Q07_ANDROID_OWNER_CONFIRMATION_REQUIRED")
+        require(GfV3WriteContract.validId(eventId) && GfV3WriteContract.validId(key)) { "Q07_ID_INVALID" }
+        val event = JSONObject().put("eventId", eventId).put("eventType", "insulin_injection")
+            .put("status", "confirmed").put("provenance", "CONFIRMED_ACTUAL")
+            .put("userConfirmed", true).put("insulinId", "rinfast").put("insulinClass", "rapid")
+            .put("units", units).put("injectionSite", site).put("occurredAtUtc", atUtc)
+            .put("note", note).put("confirmationSource", "ANDROID_OWNER_DIALOG")
+        GfV3Q07InjectionContract.actual(event)
+        return port.append("actionWriter", key, revision, event)
+    }
+
+    fun correct(eventId: String, correctionId: String, key: String, revision: Long,
+                recordVersion: Int, units: Double, site: String, reason: String,
+                ownerConfirmedByAndroid: Boolean): JSONObject {
+        if (!ownerConfirmedByAndroid) throw SecurityException("Q07_ANDROID_OWNER_CONFIRMATION_REQUIRED")
+        require(GfV3WriteContract.validId(eventId) && GfV3WriteContract.validId(correctionId) &&
+            GfV3WriteContract.validId(key)) { "Q07_EDIT_ID_INVALID" }
+        require(recordVersion >= 0 && reason.trim().length in 3..500) { "Q07_EDIT_REASON_REQUIRED" }
+        GfV3Q07InjectionContract.dose(units)
+        require(site in GfV3Q07InjectionContract.sites) { "Q07_SITE_INVALID" }
+        return port.correct("events", eventId, correctionId, key, revision,
+            recordVersion, JSONObject().put("units", units).put("injectionSite", site),
+            reason, "OWNER_MANUAL")
+    }
+}
